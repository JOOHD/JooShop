# 복사해서 `.env`로 만든 뒤 값을 채우세요. (.env는 .gitignore 대상이라 커밋되지 않습니다)
#   cp .env.example .env

# --- MySQL ---
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me

# --- JWT (충분히 긴 랜덤 문자열) ---
JWT_SECRET=change-me-to-a-long-random-string

# --- 메일 인증 ---
MAIL_USERNAME=
MAIL_PASSWORD=

# --- OAuth2: Kakao ---
KAKAO_CLIENT_ID=
KAKAO_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/login/oauth2/code/kakao

# --- OAuth2: Naver ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:8080/login/oauth2/code/naver

# --- OAuth2: Google (사용하지 않으면 비워 둠) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# --- 결제 (포트원/Iamport) ---
IMP_API_KEY=
IMP_SECRET_KEY=

# --- 주소 ---
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:8080

# --- nginx ---
NGINX_SERVER=localhost
